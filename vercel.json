{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!images/|coming-soon\\.html).*)",
      "has": [
        {
          "type": "host",
          "value": "scheedcole.com"
        }
      ],
      "destination": "/coming-soon.html",
      "permanent": false
    },
    {
      "source": "/:path((?!images/|coming-soon\\.html).*)",
      "has": [
        {
          "type": "host",
          "value": "www.scheedcole.com"
        }
      ],
      "destination": "/coming-soon.html",
      "permanent": false
    }
  ]
}
